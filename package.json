{
  "name": "danmu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vendor:ort": "node scripts/vendor-ort.mjs",
    "hash:models": "node scripts/hash-models.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "geist": "^1.3.1",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^1.17.0",
    "next": "^15.5.22",
    "postprocessing": "^6.36.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.184.0",
    "three-stdlib": "^2.34.0",
    "uuid": "^11.0.3",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@types/three": "^0.184.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "@eslint/eslintrc": "^3.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.22",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "onnxruntime-web": "1.27.0",
    "postcss": "^8.5.18",
    "semver": "^7.8.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "// overrides": [
      "Advisory fixes for transitive packages nothing here depends on directly.",
      "Each range stays INSIDE the major it patches: an override of '>=1.1.16'",
      "also matches 5.0.8, so the loose form silently promoted every",
      "brace-expansion in the tree onto the 5.x line. Caret ranges keep each",
      "consumer on the major it was written against.",
      "Drop an entry once the real dependency ships the fix itself.",
      "",
      "postcss and sharp are pinned by Next itself, so they need an override",
      "rather than a bump: Next 15.5.22 depends on postcss 8.4.31 exactly and on",
      "sharp ^0.34. Both are patch-compatible with the versions here. sharp is",
      "only ever reached through the Image Optimizer, which this app has no",
      "`images` config for and never calls — see next.config.mjs."
    ],
    "overrides": {
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.2",
      "brace-expansion@5": "^5.0.8",
      "js-yaml@4": "^4.3.0",
      "glob@10": "^10.5.0",
      "protobufjs@7": "^7.6.5",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0"
    }
  }
}
